# Cloned Community-Forensics source (for reading/importing the model class)
_commfor_src/

# Downloaded Community-Forensics model weights + patched config
_commfor_cache/

# Eval data and derived artifacts — large, reproducible via the harness
eval_harness/data/
eval_harness/predictions/
eval_harness/calibration/
eval_harness/results/

# Exported model artifacts (large; rebuild via export_onnx.py)
models/
extension/models/
*.onnx
*.onnx.data

# Vendored onnxruntime-web runtime (large; regenerated by build.py)
extension/lib/

# Local smoke-test images (regenerated by build.py / from the eval set)
extension/test_images/

# Scratch artifacts from the harness (reproducible, not shipping)
eval_harness/_feat_cache.pt
eval_harness/robust_head*.json
eval_harness/fetch_real_diverse.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

